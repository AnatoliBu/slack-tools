# Copy to .env and fill in. .env is gitignored.
# Get tokens automatically:  python extract_tokens.py https://your-workspace.slack.com

# Slack browser tokens — act as YOUR user. Both required (xoxc alone = invalid_auth).
SLACK_XOXC="xoxc-..."
SLACK_XOXD="xoxd-..."

# Workspace URL — used by extract_tokens.py and for building archive links.
SLACK_WORKSPACE_URL="https://your-workspace.slack.com"

# Optional — command run on 401/expiry to rewrite this .env with fresh tokens.
# Hands-off refresh via https://github.com/AnatoliBu/cookie-jar :
# SLACK_TOKEN_REFRESH_CMD="python /path/to/cookie-jar/refresh_env.py .env SLACK_XOXC=slack/xoxc SLACK_XOXD=slack/xoxd"

# Optional — set to 0 to stop the self-DM notification when posting to channels.
# SLACK_NOTIFY_CHANNELS=1
